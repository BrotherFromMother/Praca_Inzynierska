# Plik zarządzany przez Ansible (rola traefik).
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: stepca

providers:
  docker:
    exposedByDefault: false
    network: {{ traefik_network }}

certificatesResolvers:
  stepca:
    acme:
      email: {{ traefik_acme_email }}
      storage: /acme/acme.json
      caServer: {{ traefik_acme_ca_server }}
      certificatesDuration: {{ traefik_cert_duration_hours }}
      httpChallenge:
        entryPoint: web

log:
  level: INFO

accessLog: {}