# Plik zarządzany przez Ansible (rola step_ca).
services:
  step-ca:
    image: {{ step_ca_image }}
    container_name: step-ca
    restart: unless-stopped
    environment:
      DOCKER_STEPCA_INIT_NAME: "{{ step_ca_name }}"
      DOCKER_STEPCA_INIT_DNS_NAMES: "{{ step_ca_dns_names | join(',') }}"
      DOCKER_STEPCA_INIT_PROVISIONER_NAME: "{{ step_ca_provisioner_name }}"
      DOCKER_STEPCA_INIT_ACME: "true"
      DOCKER_STEPCA_INIT_PASSWORD_FILE: /run/secrets/step_ca_password
    secrets:
      - step_ca_password
    volumes:
      - step-ca-data:/home/step
    ports:
      - "9000:9000"
    networks:
      - {{ step_ca_network }}

secrets:
  step_ca_password:
    file: ./secrets/step_ca_password

volumes:
  step-ca-data:

networks:
  {{ step_ca_network }}:
    external: true